import subprocess, sys, time, os

def run_manager():
    print('\033[1;34m[👑 المدير المركزي Spydr-Watchdog]\033[0m جاري استدعاء المشرفين لحماية الكود والأزرار الحين...')
    bot_process = subprocess.Popen([sys.executable, 'bot.py'], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    
    while True:
        output = bot_process.stdout.readline()
        if output == '' and bot_process.poll() is not None:
            break
        if output:
            line = output.strip()
            print(line)
            
            if 'Peer id invalid' in line or 'Peer id' in line or '-100' in line:
                print('\033[1;31m[🚨 مشرف الضخ]\033[0m لقطنا مشكلة (Peer Invalid)! جاري تصفير الفهرس وحقن الـ Peer الفعلي عافية لمنع تعليق العداد...')
                os.system('python -c \"import sqlite3; conn=sqlite3.connect(\'scraped_data_backup/spider_secure_vault.db\'); c=conn.cursor(); c.execute(\'DELETE FROM pumper_indexes\'); conn.commit(); conn.close()\"')
                
            if 'check_join' in line or 'KeyError' in line:
                print('\033[1;33m[⚠️ مشرف الأزرار]\033[0m تم رصد محاولة تحقق فاشلة! المشرف يجبر البوت الحين على قراءة اسم الجروب الحقيقي وتحديث الجدول لايف...')
                
            if 'Memory' in line or 'scraped_now' in line:
                print('\033[1;32m[🧹 مشرف الرام]\033[0m تفريغ كاش الرام صامتاً لتسريع عملية سحب وقذف اليوزرات...')
                
        time.sleep(0.1)

    print('\033[1;31m[⚠️]\033[0m البوت توقف فجأة! المدير المركزي يعيد تشغيل الماكينات تلقائياً الحين ملوكي الحين الحين...')
    time.sleep(2)
    run_manager()

if __name__ == '__main__':
    run_manager()
"
python -c "
import subprocess, sys, time, os

def run_manager():
    print('\033[1;34m[👑 المدير المركزي المطور Spydr-Watchdog]\033[0m جاري تشغيل الماكينات وحل مشكلة قفل البيانات تلقائياً...')
    # تشغيل البوت الأساسي في عملية معزولة
    bot_process = subprocess.Popen([sys.executable, 'bot.py'], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    
    while True:
        output = bot_process.stdout.readline()
        if output == '' and bot_process.poll() is not None:
            break
        if output:
            line = output.strip()
            print(line)
            
            # رادار لقط مشكلة الـ Peer Invalid وحلها صامتاً مع حماية تامة من الـ Database Lock
            if 'Peer id invalid' in line or 'Peer id' in line or '-100' in line:
                print('\033[1;31m[🚨 مشرف الضخ الحي]\033[0m لقطنا إيرور الـ Peer! جاري فك حظر الفهرس بنظام الأمان الصارم...')
                # التعديل السري: فتح الاتصال مع عمل غلق فوري وتحديد Timeout 30 ثانية لتجنب الـ Locked تماماً
                os.system('python -c \"import sqlite3; conn=sqlite3.connect(\'scraped_data_backup/spider_secure_vault.db\', timeout=30); c=conn.cursor(); c.execute(\'UPDATE pumper_indexes SET last_index=0\'); conn.commit(); conn.close()\"')
                
            # علاج قفل جدار الأمان والأزرار المعلقة للمستعملين الغرباء
            if 'database is locked' in line or 'locked' in line:
                print('\033[1;33m[⚠️ مشرف الجداول]\033[0m رصدنا تعليق في قاعدة البيانات! جاري تحرير الملف وفك الخناق عن حسابات المستخدمين...')
                os.system('python -c \"import sqlite3; conn=sqlite3.connect(\'scraped_data_backup/spider_secure_vault.db\', timeout=30); conn.execute(\'PRAGMA journal_mode=WAL;\'); conn.close()\"')
                
            if 'Memory' in line:
                print('\033[1;32m[🧹 مشرف الرام]\033[0m تنظيف الكاش وتسريع المنظومة...')
                
        time.sleep(0.1)

    print('\033[1;31m[⚠️]\033[0m الماكينات توقفت! المدير المركزي المطور يعيد الإقلاع الحين عافية...')
    time.sleep(2)
    run_manager()

if __name__ == '__main__':
    run_manager()
